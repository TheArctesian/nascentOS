/* Scoped to the installer process; the live desktop keeps its Nordic theme. */
QWidget#mainApp { background: #2e3440; color: #eceff4; }
QWidget#sidebarApp { background: #2e3440; border-right: 1px solid #434c5e; }
QWidget#viewManager, QWidget#slideshow { background: #2e3440; }
QListView#sidebarMenuApp { background: #2e3440; border: none; outline: none; }
QLabel#nascentProductName { color: #eceff4; font-size: 16px; font-weight: 600; }
QPushButton {
    color: #eceff4; background: #3b4252; border: 1px solid #4c566a;
    border-radius: 6px; min-height: 20px; padding: 8px 16px;
}
QPushButton:hover { background: #434c5e; border-color: #81a1c1; }
QPushButton:pressed { background: #4c566a; }
QPushButton:disabled { color: #a2aab8; background: #343b49; border-color: #434c5e; }
QPushButton:focus, QToolButton:focus { border: 2px solid #88c0d0; }
QPushButton#view-button-next:enabled { color: #2e3440; background: #88c0d0; border-color: #88c0d0; }
QPushButton#view-button-next:enabled:hover { background: #8fbcbb; }
QPushButton#aboutButton, QPushButton#debugButton { background: transparent; border-color: transparent; }
QLineEdit, QComboBox, QSpinBox {
    color: #eceff4; background: #3b4252; border: 1px solid #4c566a;
    border-radius: 5px; min-height: 20px; padding: 7px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #88c0d0; }
QCheckBox, QRadioButton { spacing: 8px; min-height: 28px; }
QLabel#exec-message { color: #d8dee9; min-height: 24px; }
QTabWidget#nascentExecutionTabs::pane { border: none; background: transparent; }
QProgressBar#exec-progress {
    border: none; background: #434c5e; border-radius: 3px;
    min-height: 6px; max-height: 6px;
}
QProgressBar#exec-progress::chunk { background: #88c0d0; border-radius: 3px; }
QLabel#nascentProgressValue { color: #eceff4; min-width: 42px; }
QToolBar#nascentLogToolbar { border: none; spacing: 0px; padding: 0px; }
QToolBar#nascentLogToolbar QToolButton {
    color: #d8dee9; background: transparent; border: 1px solid transparent;
    border-radius: 5px; min-width: 28px; min-height: 28px; padding: 4px;
}
QToolBar#nascentLogToolbar QToolButton:hover { background: #434c5e; }
QLabel#nascentPageTitle { color: #eceff4; font-size: 26px; font-weight: 600; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px; border: 2px solid #4c566a; background: #3b4252; border-radius: 4px;
}
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #81a1c1; }
QCheckBox::indicator:checked { background: #88c0d0; border-color: #88c0d0; }
QRadioButton::indicator:checked {
    border-color: #88c0d0;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #88c0d0, stop: 0.5 #88c0d0, stop: 0.56 #3b4252, stop: 1 #3b4252);
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: #4c566a; border-radius: 3px; }
QScrollBar::handle:vertical { min-height: 32px; }
QScrollBar::handle:horizontal { min-width: 32px; }
QScrollBar::handle:hover { background: #81a1c1; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
