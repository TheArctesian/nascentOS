#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s release-support -p 'test_*.py'
if command -v actionlint >/dev/null 2>&1; then
  actionlint -config-file release-support/actionlint.yaml .github/workflows/check.yml .github/workflows/release.yml
elif command -v nix >/dev/null 2>&1 && [[ -f flake.lock ]]; then
  # Use the repository's locked nixpkgs, not an unpinned registry lookup.
  nix shell --inputs-from . nixpkgs#actionlint -c actionlint -config-file release-support/actionlint.yaml .github/workflows/check.yml .github/workflows/release.yml
else
  echo 'Environment failure: actionlint or Nix with the integrated flake.lock is required.' >&2
  exit 127
fi
bash -n release-support/preflight release-support/verify
