#!/usr/bin/env bash
set -euo pipefail
command -v nix >/dev/null || { echo 'Environment failure: provision Nix on the release runner.' >&2; exit 127; }
actual=$(nix eval --impure --raw --expr builtins.currentSystem)
[[ "$actual" == "$1" ]] || { echo "Native runner required: expected $1, got $actual" >&2; exit 1; }
python3 - <<'PY'
import shutil
for path in ('.', '/nix/store'):
    free = shutil.disk_usage(path).free / 1024**3
    print(f'{path}: {free:.1f} GiB free')
    if free < 30:
        raise SystemExit(f'Environment failure: at least 30 GiB free required on {path} for the ISO-only hosted build')
PY
