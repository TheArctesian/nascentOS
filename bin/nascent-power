#!/usr/bin/env bash
# nascent:summary=Power menu: lock, suspend, log out, reboot or shut down
set -euo pipefail
theme=$(nascent-theme path)
choice=$(printf '%s\n' Lock Suspend 'Log out' Reboot 'Shut down' |
  fuzzel --config "$theme/fuzzel.ini" --dmenu --lines 5 --prompt 'Power > ') || exit 0
case "$choice" in
  Lock) exec nascent-launch lock ;;
  Suspend) exec systemctl suspend ;;
  'Log out') exec hyprctl dispatch 'hl.dsp.exit()' ;;
  Reboot) exec systemctl reboot ;;
  'Shut down') exec systemctl poweroff ;;
esac
