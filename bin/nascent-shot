#!/usr/bin/env bash
# nascent:summary=Take a screenshot (full, area or delayed) and copy it to the clipboard
set -euo pipefail
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "${1:-}" in
  full) grim "$file" ;;
  area) region=$(slurp) || exit 0; grim -g "$region" "$file" ;;
  delayed) sleep 3; grim "$file" ;;
  *) echo 'Usage: nascent-shot full|area|delayed' >&2; exit 2 ;;
esac
wl-copy --type image/png < "$file"
notify-send -a nascentOS -i "$file" 'Screenshot copied' "$file"
