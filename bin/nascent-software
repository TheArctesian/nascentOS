#!/usr/bin/env bash
# nascent:summary=Find, install and remove software by editing /etc/nixos/nascent-software.nix and rebuilding
set -euo pipefail
nixos=${NASCENT_NIXOS_DIR:-/etc/nixos}
module=$nixos/nascent-software.nix
catalog=${NASCENT_CATALOG:-$nixos/nascentos/installer/software-selection/catalog.json}
system="$(uname -m)-linux"

# One Python helper owns the file format so the menus and the edits agree on it.
# Catalog IDs live in nascent.software.selected; any other nixpkgs attribute in
# nascent.software.packages.
helper() {
  python3 - "$@" <<'PY'
import json, re, sys
action, module, catalog, system, *names = sys.argv[1:]
apps = [a for a in json.load(open(catalog))["apps"] if system in a.get("platforms", [])]
by_id = {a["id"]: a for a in apps}
try:
    text = open(module).read()
except FileNotFoundError:
    sys.exit(f"{module} does not exist; installing software needs an installed nascentOS system.")

def find(key):
    return re.search(r"nascent\.software\.%s = \[([^\]]*)\];" % key, text)

selected_match = find("selected")
if not selected_match:
    sys.exit(f"Cannot find 'nascent.software.selected = [ ... ];' in {module}.")
packages_match = find("packages")
selected = re.findall(r'"([^"]+)"', selected_match.group(1))
packages = re.findall(r'"([^"]+)"', packages_match.group(1)) if packages_match else []

if action == "list":
    for a in apps:
        mark = "installed" if a["id"] in selected else ("manual" if a["kind"] != "package" else "")
        print("\t".join([a["id"], a.get("group", "Other"), a["name"], mark, a.get("url", ""),
                         a.get("description", "")]))
    sys.exit(0)
if action == "installed":
    # Catalog entries report their nixpkgs attribute so search can mark them too.
    for i in selected:
        print(by_id[i].get("package") or i if i in by_id else i)
    print("\n".join(packages))
    sys.exit(0)

for name in names:
    if not re.fullmatch(r"[A-Za-z0-9_+-][A-Za-z0-9_.+-]*", name):
        sys.exit(f"Not a package name: {name}")
    if name in by_id and by_id[name]["kind"] != "package":
        sys.exit(f"{by_id[name]['name']} is installed manually: {by_id[name].get('url', '')}")
catalog_by_package = {a.get("package"): a["id"] for a in apps if a.get("package")}
for name in names:
    target = name if name in by_id else catalog_by_package.get(name)
    if action == "add":
        if target:
            selected += [] if target in selected else [target]
        elif name not in packages:
            packages.append(name)
    else:
        if target and target in selected:
            selected.remove(target)
        elif name in packages:
            packages.remove(name)
        else:
            sys.exit(f"{name} was not installed with nascent software.")

def render(values):
    return " ".join(json.dumps(v) for v in values)

text = (text[:selected_match.start()] + f"nascent.software.selected = [ {render(selected)} ];"
        + text[selected_match.end():])
line = f"nascent.software.packages = [ {render(packages)} ];"
if packages_match:
    text = re.sub(r"nascent\.software\.packages = \[[^\]]*\];", lambda _: line, text, count=1)
else:
    text = re.sub(r"(\n([ \t]*)nascent\.software\.selected = [^\n]*)",
                  lambda m: m.group(1) + "\n" + m.group(2) + line, text, count=1)
sys.stdout.write(text)
PY
}

pause() {
  if [[ -n ${NASCENT_PAUSE:-} ]]; then echo; read -rp 'Press Enter to close' _ || true; fi
}

apply() {
  local action=$1; shift
  [[ $# -gt 0 ]] || { echo "Usage: nascent software $action NAME..." >&2; exit 2; }
  local updated backup status=0
  updated=$(helper "$action" "$module" "$catalog" "$system" "$@") || { pause; return 1; }
  backup=$(mktemp)
  cp "$module" "$backup"
  printf '%s\n' "$updated" | sudo tee "$module" >/dev/null
  if sudo git -C "$nixos" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    sudo git -C "$nixos" add "$module"
  fi
  printf '\n\033[1m%s:\033[0m %s\n\n' "${action^}" "$*"
  if sudo nixos-rebuild switch --flake "$nixos#nascent"; then
    printf '\n\033[32m󰄬 Done.\033[0m %s: %s\n' "$action" "$*"
  else
    sudo cp "$backup" "$module"
    printf '\n\033[31mRebuild failed;\033[0m %s was restored.\n' "$module" >&2
    status=1
  fi
  rm -f "$backup"
  pause
  return $status
}

# Rebuilds need sudo, so desktop entry points run in a terminal the user can watch.
in_terminal() {
  local command
  printf -v command '%q ' nascent-software "$@"
  exec nascent-launch terminal --class nascent-software env NASCENT_PAUSE=1 bash -c "$command"
}

# Our own index: name, description, version, licence, free, homepage, command and
# long description per package, one tab-separated line each, shortest names first
# so fzf's index tiebreak favours them. The channel's packages.json is 400 MB, so
# it is parsed as a stream rather than loaded whole.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/nascent-software
index_file=$cache/nixpkgs-$system.tsv
index_url=${NASCENT_PACKAGES_URL:-https://channels.nixos.org/nixos-unstable/packages.json.br}

build_index() {
  python3 -c '
import json, sys
system = sys.argv[1]
decoder, buf, pos, eof = json.JSONDecoder(), "", 0, False

def fill():
    global buf, pos, eof
    chunk = sys.stdin.read(1 << 20)
    eof = not chunk
    buf, pos = buf[pos:] + chunk, 0

def skip():
    global pos
    while True:
        while pos < len(buf) and buf[pos] in " \t\r\n,:":
            pos += 1
        if pos < len(buf) or eof:
            return
        fill()

def value():
    global pos
    while True:
        try:
            item, end = decoder.raw_decode(buf, pos)
            if end < len(buf) or eof:
                pos = end
                return item
        except ValueError:
            if eof:
                raise
        fill()

def flat(text):
    return " ".join(str(text or "").split())

def licence(meta):
    items = meta.get("license") or []
    items = items if isinstance(items, list) else [items]
    names = [i.get("spdxId") or i.get("fullName") or i.get("shortName") or "" if isinstance(i, dict) else str(i)
             for i in items]
    free = all(i.get("free", True) for i in items if isinstance(i, dict))
    return ", ".join(n for n in names if n), "1" if free else "0"

fill()
start = buf.find("\"packages\":{")
if start < 0:
    sys.exit("The package list has an unexpected format.")
pos = start + len("\"packages\":{")
rows = []
while True:
    skip()
    if pos >= len(buf) or buf[pos] == "}":
        break
    name = value()
    skip()
    package = value()
    meta = package.get("meta") or {}
    platforms = meta.get("platforms") or []
    if meta.get("broken") or (platforms and system not in platforms):
        continue
    homepage = meta.get("homepage") or ""
    homepage = homepage[0] if isinstance(homepage, list) and homepage else homepage
    rows.append([name, flat(meta.get("description")), flat(package.get("version")), *licence(meta),
                 flat(homepage), flat(meta.get("mainProgram")), flat(meta.get("longDescription"))])
rows.sort(key=lambda r: (len(r[0]), r[0]))
sys.stdout.writelines("\t".join(r) + "\n" for r in rows)
' "$system"
}

index() {
  if [[ -s $index_file && -z $(find "$index_file" -mtime +7 2>/dev/null) ]]; then return; fi
  local tmp
  mkdir -p "$cache"
  tmp=$(mktemp "$index_file.XXXXXX")
  echo 'Downloading the nixpkgs package list…' >&2
  if curl -fsSL "$index_url" | brotli -dc | build_index >"$tmp" && [[ -s $tmp ]]; then
    mv "$tmp" "$index_file"
  else
    rm -f "$tmp"
    # A stale list is better than none when offline.
    [[ -s $index_file ]] || { echo 'Could not download the nixpkgs package list.' >&2; return 1; }
  fi
}

# Fields: installed mark, name, padded and dimmed description. fzf matches the name
# and description; the name alone is accepted and previewed.
rows() {
  local installed
  installed=$(helper installed "$module" "$catalog" "$system")
  index
  awk -F'\t' -v list="$installed" -v only="${1:-}" '
    BEGIN { n = split(list, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") mine[a[i]] = 1 }
    only == "installed" && !($1 in mine) { next }
    { seen[$1] = 1
      pad = 28 - length($1); if (pad < 2) pad = 2
      printf "%s\t%s\t%*s\033[90m%s\033[0m\n", ($1 in mine) ? "\033[32m●\033[0m" : " ", $1, pad, "", $2 }
    END { if (only == "installed") for (name in mine) if (!(name in seen)) printf "\033[32m●\033[0m\t%s\t\n", name }
  ' "$index_file"
}

preview() {
  local name=$1 line
  if helper installed "$module" "$catalog" "$system" | grep -qxF -- "$name"; then
    printf '\033[32m● Installed\033[0m  ·  Ctrl-R removes it\n\n'
  fi
  line=$(awk -F'\t' -v n="$name" '$1 == n { print; exit }' "$index_file" 2>/dev/null)
  if [[ -z $line ]]; then
    printf '\033[1;36m%s\033[0m\n\nNo details in the package index.\n' "$name"
    return
  fi
  local _ description version licence free homepage program long
  IFS=$'\t' read -r _ description version licence free homepage program long <<<"$line"
  printf '\033[1;36m%s\033[0m  \033[90m%s\033[0m\n\n' "$name" "$version"
  [[ -n $description ]] && printf '%s\n\n' "$description"
  if [[ $free == 1 ]]; then
    printf '\033[90mLicence\033[0m   %s \033[32m(free)\033[0m\n' "${licence:-unknown}"
  else
    printf '\033[90mLicence\033[0m   %s \033[33m(unfree, allowed when you install it)\033[0m\n' "${licence:-unknown}"
  fi
  [[ -n $homepage ]] && printf '\033[90mHomepage\033[0m  %s\n' "$homepage"
  [[ -n $program ]] && printf '\033[90mCommand\033[0m   %s\n' "$program"
  [[ -n $long ]] && printf '\n%s\n' "$long"
  return 0
}

search() {
  [[ -t 0 && -t 1 ]] || in_terminal search
  helper installed "$module" "$catalog" "$system" >/dev/null || { pause; exit 1; }
  index || { pause; exit 1; }
  local self output key names=()
  self=$(command -v nascent-software)
  # Terminal palette colours keep the picker on the active nascentOS theme.
  output=$(rows | fzf --ansi --multi --delimiter '\t' --nth 2,3 --accept-nth 2 \
      --layout reverse --border rounded --border-label ' 󰏔  Software ' --border-label-pos 3 \
      --prompt '  ' --pointer '▌' --marker '+' --info inline-right --tiebreak begin,index --tabstop 1 --no-hscroll \
      --footer 'Tab select · Enter install · Ctrl-R remove · Ctrl-L installed · Ctrl-A all · Esc quit' \
      --expect ctrl-r \
      --preview "$self preview {2}" \
      --preview-window 'right,45%,border-left,wrap,<50(down,50%,border-top,wrap)' \
      --bind "ctrl-l:reload($self _rows installed)+change-prompt(● )" \
      --bind "ctrl-a:reload($self _rows)+change-prompt(  )" \
      --color 'fg:-1,bg:-1,hl:6,fg+:15,bg+:0,hl+:6,info:8,prompt:4,pointer:6,marker:2,header:8,border:8,label:4,spinner:6' \
    ) || exit 0
  key=$(head -n1 <<<"$output")
  mapfile -t names < <(tail -n +2 <<<"$output" | sed '/^$/d')
  [[ ${#names[@]} -gt 0 ]] || exit 0
  if [[ $key == ctrl-r ]]; then apply remove "${names[@]}"; else apply add "${names[@]}"; fi
}

menu() {
  local theme rows groups group choice id name mark url search='󰍉  Search all packages'
  theme=$(nascent-theme path)
  dmenu() { fuzzel --config "$theme/fuzzel.ini" --dmenu "$@"; }
  rows=$(helper list "$module" "$catalog" "$system") || {
    notify-send -a nascentOS 'Software' "$(helper list "$module" "$catalog" "$system" 2>&1 >/dev/null)" 2>/dev/null || true
    exit 1
  }
  groups=$(printf '%s\n' "$search"; cut -f2 <<<"$rows" | awk '!seen[$0]++')
  group=$(dmenu --prompt '󰏔  ' --placeholder 'Install software' --lines "$(wc -l <<<"$groups")" <<<"$groups") || exit 0
  [[ $group == "$search" ]] && in_terminal search
  choice=$(awk -F'\t' -v g="$group" '$2 == g {
      icon = $4 == "installed" ? "󰄬" : ($4 == "manual" ? "󰏌" : "󰐕")
      printf "%s  %s\t%s\n", icon, $3, $1 }' <<<"$rows" |
    dmenu --lines "$(awk -F'\t' -v g="$group" '$2 == g' <<<"$rows" | wc -l)" --with-nth 1 --accept-nth 2 --prompt '󰏔  ' --placeholder "$group  ·  󰄬 installed") || exit 0
  IFS=$'\t' read -r id _ name mark url _ < <(awk -F'\t' -v i="$choice" '$1 == i' <<<"$rows")
  case $mark in
    manual) exec xdg-open "$url" ;;
    installed)
      [[ $(printf '%s\n' "Remove $name" Cancel | dmenu --lines 2 --prompt '󰆴  ') == "Remove $name" ]] || exit 0
      in_terminal remove "$id" ;;
    *) in_terminal add "$id" ;;
  esac
}

case "${1:-menu}" in
  menu) menu ;;
  search|find) search ;;
  list) helper list "$module" "$catalog" "$system" |
    awk -F'\t' '{ printf "%-22s %-16s %-10s %s\n", $1, $2, $4, $3 }' ;;
  installed) helper installed "$module" "$catalog" "$system" | sed '/^$/d' ;;
  add|remove) action=$1; shift; apply "$action" "$@" ;;
  preview) preview "${2:?}" ;;
  _rows) rows "${2:-}" ;;
  -h|--help|help)
    cat <<'HELP'
nascent software                Open the install menu (curated picks and search)
nascent software search         Search nixpkgs names and descriptions; Tab selects, Enter installs, Ctrl-R removes
nascent software list           Show the curated catalog and what is installed
nascent software installed      Show everything installed with nascent software
nascent software add NAME...    Add catalog IDs or nixpkgs packages and rebuild
nascent software remove NAME... Remove them again and rebuild
HELP
    ;;
  *) echo "Unknown command: $1. Run nascent software --help." >&2; exit 2 ;;
esac
