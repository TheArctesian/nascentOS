#!/usr/bin/env bash
# nascent:summary=Open a small discoverable desktop command menu
set -euo pipefail
theme=$(nascent-theme path)
items=('󰀻  Applications' '󰆍  Terminal' '󰹑  Screenshot area' '󰅌  Clipboard history'
  '󰂛  Do not disturb' '󰏘  Theme: Nord' '󰏘  Theme: Tokyo Night' '󰚩  Agent'
  '󰌾  Lock' '⏻  Power…')
if command -v nascent-install >/dev/null 2>&1; then items=('󰏔  Install nascentOS' "${items[@]}"); fi
choice=$(printf '%s\n' "${items[@]}" |
  fuzzel --config "$theme/fuzzel.ini" --dmenu --lines "${#items[@]}" --prompt '❯  ' \
    --placeholder 'Search the desktop menu') || exit 0
case "${choice#*  }" in
  'Install nascentOS') exec nascent-install ;;
  Applications) exec nascent-launch apps ;;
  Terminal) exec nascent-launch terminal ;;
  'Screenshot area') exec nascent-shot area ;;
  'Clipboard history') exec nascent-clipboard pick ;;
  'Do not disturb') exec nascent-notify dnd ;;
  'Theme: Nord') exec nascent-theme set nord ;;
  'Theme: Tokyo Night') exec nascent-theme set tokyo-night ;;
  Agent) exec nascent-agent-ui ;;
  Lock) exec nascent-launch lock ;;
  'Power…') exec nascent-power ;;
esac
